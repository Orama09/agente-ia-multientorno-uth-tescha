# Copia este archivo a .env.local para desarrollo local sin Docker.
# En Docker, docker-compose.yml inyecta valores equivalentes automaticamente.

# Ollama (URL base, sin /api)
OLLAMA_URL=http://localhost:11434

# ChromaDB (URL base, sin /api/v2)
CHROMA_URL=http://localhost:8000

# Modelos de Ollama
# Recomendado en CPU / desarrollo local (rapido):
OLLAMA_GENERATION_MODEL=llama3.2:1b
# En equipos con GPU o mas RAM puedes usar: llama3
# OLLAMA_GENERATION_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Mantener modelos en memoria de Ollama (reduce cold start / swap)
OLLAMA_KEEP_ALIVE=30m

# Umbral de distancia RAG (L2). Logs locales suelen mostrar ~200-300.
# Si ninguna distancia es menor, no se inyecta contexto (sin fallback ciego).
# RAG_MAX_DISTANCE=280

# Coleccion vectorial en ChromaDB
CHROMA_COLLECTION_NAME=school_documents

# Logs de rendimiento chat/RAG/Ollama (solo consola del servidor)
# true|false fuerza on/off. Si se omite: on en development, off en production.
# ENABLE_PERFORMANCE_LOGS=true

# --- Experiencia del asistente (avatar + voz) ---
# Proveedor de avatar. Default: local-image
# Experimental: threejs (requiere public/models/avatar/avatar-tescha.glb)
# Futuros (no implementados): rive | live2d | liveavatar
NEXT_PUBLIC_AVATAR_PROVIDER=local-image

# Proveedor TTS. Implementados: none | web-speech
# Futuro (no implementado): external
NEXT_PUBLIC_TTS_PROVIDER=web-speech

# Si la voz inicia activada (solo aplica con web-speech)
NEXT_PUBLIC_VOICE_ENABLED_BY_DEFAULT=false

# Opcional: avatar HeyGen / LiveAvatar (no implementado aun)
# HEYGEN_API_KEY=
