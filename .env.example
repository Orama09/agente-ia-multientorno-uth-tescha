# Copia este archivo a .env.local para desarrollo local sin Docker.
# En Docker, docker-compose.yml inyecta valores equivalentes automaticamente.

# Ollama (URL base, sin /api)
OLLAMA_URL=http://localhost:11434

# ChromaDB (URL base, sin /api/v2)
CHROMA_URL=http://localhost:8000

# Modelos de Ollama
OLLAMA_GENERATION_MODEL=llama3
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Coleccion vectorial en ChromaDB
CHROMA_COLLECTION_NAME=school_documents

# Opcional: avatar HeyGen (no implementado aun)
# HEYGEN_API_KEY=
